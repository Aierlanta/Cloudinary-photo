# 数据库配置
DATABASE_URL="mysql://username:password@host:port/database?sslaccept=strict"
BACKUP_DATABASE_URL="mysql://username:password@host:port/database?sslaccept=strict"
# 外部 Cron 触发备份时使用的 Bearer token，必须只配置在主服务环境变量中
BACKUP_CRON_SECRET=your_backup_cron_secret
# 可选：外部 Cron 触发的最小成功备份间隔，默认 6 小时
# BACKUP_CRON_MIN_INTERVAL_MS=21600000

# Cloudinary 配置
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# tgState 配置 (第三方服务)
TGSTATE_BASE_URL=https://you-admin
# TGSTATE_PASSWORD=none  # 由于密码鉴权存在 bug，暂时不使用密码
TGSTATE_TIMEOUT=30000

# Telegram 直连配置 (推荐)
# 支持多个 Bot Token (逗号分隔),实现轮询和负载均衡
TELEGRAM_BOT_TOKENS=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11,123456:XYZ-GHI5678jkLmn-abc12D3e4f567gh89
# 或单个 Token
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_TIMEOUT=30000
# 可选: 指定上传到的 chat_id (默认使用 bot 自己的 Saved Messages)
# TELEGRAM_CHAT_ID=your_chat_id


# Telegram 代理（仅服务端 /api/response 使用，可选）
# 启用后，服务端访问 https://api.telegram.org 将通过该代理；默认关闭
TELEGRAM_PROXY_ENABLED=false
# 代理地址示例（HTTP/HTTPS 代理）：http://127.0.0.1:10808
# 留空则不使用代理
TELEGRAM_PROXY_URL=

# 响应缓存（服务端内存缓存，可选）
# 随机直接响应预取队列默认 20 分钟；滚动短时间窗口会自动缩短 TTL
RESPONSE_RANDOM_PREFETCH_TTL_MS=1200000
# 每个随机预取 key 最多保留几张已处理好的图片，命中后消费并异步补齐
RESPONSE_RANDOM_PREFETCH_PER_KEY=2
# 指定 imageId 的最终响应缓存默认 20 分钟，缓存处理后的 bytes，可重复命中不消费
RESPONSE_FINAL_CACHE_TTL_MS=1200000
RESPONSE_FINAL_CACHE_MAX_BYTES=134217728
RESPONSE_FINAL_CACHE_MAX_KEYS=128
RESPONSE_FINAL_CACHE_MAX_ENTRY_BYTES=16777216

# 图床开关（可选，未设置则默认启用）
CLOUDINARY_ENABLE=true
TGSTATE_ENABLE=true
TELEGRAM_ENABLE=true



# 多图床配置
PRIMARY_STORAGE_PROVIDER=cloudinary
BACKUP_STORAGE_PROVIDER=tgstate
FAILOVER_STRATEGY=retry_then_failover
STORAGE_RETRY_ATTEMPTS=3
STORAGE_RETRY_DELAY=1000
STORAGE_HEALTH_CHECK_INTERVAL=300
ENABLE_BACKUP_UPLOAD=false

# 管理员认证
ADMIN_PASSWORD=your_admin_password
# 多节点需要所有节点保持一致，用于签发/验证 Bearer session token
SESSION_SECRET=your_shared_session_secret

# 蜂群节点配置
# 每个后端节点必须唯一，例如 node-a、node-b
NODE_ID=node-a
# 可选：管理端展示名称
NODE_NAME=Node A
# 当前节点可被其他节点/浏览器访问的公开 API 根地址，不要以 / 结尾
PUBLIC_API_BASE_URL=https://node-a.example.com
# 跨节点 resolve 短时签名密钥；所有互通信任的节点必须保持一致
NODE_HANDOFF_SECRET=your_shared_handoff_secret
# 允许访问本节点 API 的前端来源，多个用英文逗号分隔；开发可留空或使用 *
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://frontend.example.com
# 前端可选择的后端节点列表。推荐 JSON 格式；baseUrl 不要以 / 结尾
NEXT_PUBLIC_BACKEND_NODES='[{"id":"node-a","name":"Node A","baseUrl":"https://node-a.example.com"},{"id":"node-b","name":"Node B","baseUrl":"https://node-b.example.com"}]'
# 当前 Full Node 页面默认对应的公开 API 地址，未设置时前端回退到当前 origin
NEXT_PUBLIC_PUBLIC_API_BASE_URL=http://localhost:3000
# 当前节点 ID/名称的前端展示默认值
NEXT_PUBLIC_NODE_ID=node-a
NEXT_PUBLIC_NODE_NAME=Node A

# 环境设置
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 应用程序运行端口 (可选，默认为 3000)
PORT=3000

# PostHog 分析配置 (可选)
# NEXT_PUBLIC_POSTHOG_KEY=phc_你的项目密钥
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
